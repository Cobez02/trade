# copy to .env and `set -a; source .env; set +a` — never commit .env
# --- data ---
DATABENTO_API_KEY=            # databento.com -> API keys ($125 free credit at signup)
ALPACA_API_KEY=               # paper keys are fine for the proxy lab
ALPACA_SECRET_KEY=
SPXF_ALPACA_FEED=sip          # sip needs Algo Trader Plus; iex otherwise
# --- execution (choose one) ---
PROJECTX_USER=                # TopstepX username
PROJECTX_API_KEY=             # TopstepX API key (API add-on)
PROJECTX_ACCOUNT=             # e.g. "50KTC-V2-123456"
TRADOVATE_USER=
TRADOVATE_PASS=
TRADOVATE_CID=                # Tradovate API app client id
TRADOVATE_SEC=                # ...and secret
TRADOVATE_ACCOUNT=            # e.g. "MFFU50K..." exact account name
TRADOVATE_BASE=https://demo.tradovateapi.com
# --- strategy / risk overrides (see config.py) ---
SPXF_INSTRUMENT=MES
SPXF_RISK_PER_TRADE=200
SPXF_DAILY_KILL_LOSS=700
SPXF_DAILY_PROFIT_CAP=1200
SPXF_MAX_CONTRACTS=5
